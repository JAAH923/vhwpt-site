---
import "../styles/site.css";
import BookingForm from "../components/BookingForm.astro";
import { practice, nav } from "../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;

export interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL and for marking the active nav item. */
  path: string;
  /** Lay the nav over the page's first section (the home hero). */
  overlay?: boolean;
  /** Keep the page out of search everywhere (review-only pages). */
  noindex?: boolean;
}

const { title, description, path, overlay = false, noindex = false } = Astro.props;
const canonical = `https://www.vhwpt.com${path}`;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
// The GitHub Pages preview is public; keep it out of search so it never
// competes with vhwpt.com.
const isPreview = Astro.site?.hostname !== "www.vhwpt.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://www.vhwpt.com/assets/brand/valencia-health-wellness-logo-full.png"
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="preload"
      href={withBase("/assets/fonts/inter-latin-700-normal.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={withBase("/assets/fonts/fonts.css")} />
    <link
      rel="icon"
      type="image/png"
      href={withBase("/assets/brand/valencia-health-wellness-icon.png")}
    />
    <title>{title}</title>
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <nav class:list={["site-nav", { over: overlay }]} aria-label="Primary navigation">
      <a class="brand" href={withBase()}>
        <img
          src={withBase("/assets/brand/valencia-health-wellness-icon.png")}
          alt=""
          width="40"
          height="40"
        />
        Dr. Bruce Valencia
      </a>

      <button class="menu-button btn btn-line btn-sm" type="button" aria-expanded="false" aria-controls="nav-links">
        Menu
      </button>

      <div class="nav-links" id="nav-links">
        {
          nav
            .filter((item) => item.href !== "/book")
            .map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
        }
        <a href={practice.phoneHref}>{practice.phone}</a>
        <a
          class="btn btn-line btn-sm"
          href={withBase("/book")}
          data-book=""
          aria-current={isActive("/book") ? "page" : undefined}
        >
          Book
        </a>
      </div>
    </nav>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div>
            <a class="brand" href={withBase()}>
              <img
                src={withBase("/assets/brand/valencia-health-wellness-icon.png")}
                alt=""
                width="40"
                height="40"
              />
              {practice.name}
            </a>
            <p>
              {practice.legalName}: physical therapy, personal training and wellness
              across {practice.regionLong}, and virtually nationwide.
            </p>
            <ul class="footer-contact">
              <li><a href={practice.phoneHref}>{practice.phone}</a></li>
              <li><a href={`mailto:${practice.email}`}>{practice.email}</a></li>
            </ul>
          </div>
          <nav class="footer-nav" aria-label="Footer navigation">
            <a href={withBase("/services")}>Services</a>
            <a href={withBase("/services/health-evaluation")}>Your first visit</a>
            <a href={withBase("/questions")}>Questions</a>
            <a href={withBase("/about")}>About</a>
            <a href={withBase("/book")} data-book="">Book</a>
          </nav>
        </div>

        <div class="disclaimers">
          <p>
            <strong>Medical Disclaimer:</strong> Dr. Bruce Valencia is a licensed Doctor of
            Physical Therapy (DPT). Services offered through {practice.legalName} include
            fitness coaching, personal training, and physical therapy-informed
            programming. These services are not a substitute for medical diagnosis,
            treatment, or prescription. Always consult your physician before beginning a
            new exercise program. Individuals with existing health conditions or recent
            surgery should obtain physician clearance prior to participation.
          </p>
          <p>
            <strong>Nutrition Disclaimer:</strong> Nutritional guidance provided through
            {" "}{practice.name} is intended for general wellness support and does not
            constitute medical nutritional therapy. For individualized dietary medical
            management, please consult a registered dietitian or your physician.
          </p>
        </div>

        <div class="footer-bottom">
          <nav aria-label="Social media">
            <a
              href="https://www.facebook.com/ValenciaHealthandWellness"
              rel="noopener noreferrer"
              target="_blank">Facebook</a
            >
            <a
              href="https://www.instagram.com/drbrucevdpt/"
              rel="noopener noreferrer"
              target="_blank">Instagram</a
            >
          </nav>
          <p>&copy; 2026 {practice.legalName}</p>
        </div>
      </div>
    </footer>

    <BookingForm autoOpen={path === "/book"} />

    <script>
      const button = document.querySelector<HTMLButtonElement>(".menu-button")!;
      const links = document.getElementById("nav-links")!;
      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") !== "true";
        button.setAttribute("aria-expanded", String(open));
        links.classList.toggle("open", open);
      });
    </script>
  </body>
</html>
