---
import Site from "../../layouts/Site.astro";
import PageHead from "../../components/PageHead.astro";
import Cta from "../../components/Cta.astro";
import { practice, evaluationSteps } from "../../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;
---

<Site
  title="The Health Evaluation | Dr. Bruce Valencia, DPT"
  description="A 60-minute evaluation with a Doctor of Physical Therapy: history, movement and strength assessment, findings explained, and a written plan you keep. In your home across Broward and Palm Beach County, or over video."
  path="/services/health-evaluation"
>
  <PageHead
    label="The first visit"
    title="The Health Evaluation"
    lede="Sixty minutes with a Doctor of Physical Therapy, in your home or over video. You leave knowing what is actually going on in your body and what to do about it, written down, whether or not you train with Bruce afterward."
    photo={{
      src: withBase("/assets/photos/ai/living-room-ready.webp"),
      alt: "A living room cleared for a session, with a mat and a chair by the window",
      position: "50% 70%",
    }}
  />

  <section class="section" id="what-happens" aria-labelledby="happens-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="happens-title">What happens</h2>
        <p>Four parts, in this order, in about an hour.</p>
      </div>
      <ol class="steps">
        {
          evaluationSteps.map((s) => (
            <li>
              <span class="label">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="leave-with" aria-labelledby="leave-title">
    <div class="wrap cols">
      <div>
        <h2 id="leave-title">What you leave with</h2>
        <p class="note">The plan is yours. Nothing here is contingent on booking a package afterward.</p>
      </div>
      <ul class="lines">
        <li>A written plan, with the progression spelled out</li>
        <li>A home program you can do between sessions</li>
        <li>An explanation you can repeat to your family</li>
        <li>A referral, if a physician is what you actually need</li>
      </ul>
    </div>
  </section>

  <section class="section" id="who-it-suits" aria-labelledby="suits-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="suits-title">Who it suits</h2>
      </div>
      <div class="cols">
        <div>
          <h3>A good fit if you are</h3>
          <ul class="lines">
            <li>Finished with formal PT but not back to normal</li>
            <li>Recovering from surgery or an injury</li>
            <li>Worried about balance, falls or losing independence</li>
            <li>Training around a history your last trainer did not understand</li>
            <li>Cleared by a physician and unsure what is safe</li>
          </ul>
        </div>
        <div>
          <h3>Not the right call if you</h3>
          <ul class="lines">
            <li>Have a new, undiagnosed or worsening injury: see a physician first</li>
            <li>Need emergency or urgent medical care</li>
            <li>Are looking for a diagnosis or a prescription</li>
            <li>Want a program emailed over without being assessed</li>
          </ul>
        </div>
      </div>
      <p class="note">
        Bruce is a licensed DPT providing physical therapy-informed coaching through
        {" "}{practice.legalName}. That is not a substitute for medical diagnosis or
        treatment, and saying so plainly is part of the job.
      </p>
    </div>
  </section>

  <section class="section" id="fees" aria-labelledby="fees-title">
    <div class="wrap cols">
      <div>
        <h2 id="fees-title">Fees</h2>
        <p class="note">Straight answers before you call, because nobody should have to ask twice.</p>
      </div>
      <dl class="facts">
        <div>
          <dt>Health Evaluation, 60 minutes</dt>
          <dd><span class="todo">Confirm rate</span></dd>
        </div>
        <div>
          <dt>Ongoing sessions</dt>
          <dd><span class="todo">Confirm rate</span></dd>
        </div>
        <div>
          <dt>Insurance</dt>
          <dd><span class="todo">Confirm: self-pay, or which plans</span></dd>
        </div>
        <div>
          <dt>Travel</dt>
          <dd>Included across {practice.regionLong}</dd>
        </div>
      </dl>
    </div>
  </section>

  <Cta
    title="Book the evaluation."
    body="Tell Bruce what is going on and he will come to you, or meet you on video."
  />
</Site>
