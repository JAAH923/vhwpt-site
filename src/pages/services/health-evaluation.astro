---
import Site from "../../layouts/Site.astro";
import Icon from "../../components/Icon.astro";
import { practice, evaluationSteps } from "../../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;
---

<Site
  title="The Health Evaluation | Dr. Bruce Valencia, DPT"
  description="A 60-minute evaluation with a Doctor of Physical Therapy: history, movement and strength assessment, findings explained, and a written plan you keep. In your home across Broward and Palm Beach County, or over video."
  path="/services/health-evaluation"
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">The first visit</p>
      <h1>The Health Evaluation</h1>
      <p class="page-lede">
        Sixty minutes with a Doctor of Physical Therapy, in your home or over video. You
        leave knowing what is actually going on in your body and what to do about it —
        written down, whether or not you train with Bruce afterward.
      </p>
    </div>
  </header>

  <section class="page-section" id="what-happens">
    <div class="page-section-narrow">
      <h2>What happens</h2>
      <ol class="steps">
        {
          evaluationSteps.map((s) => (
            <li>
              <span class="step-n">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <h2 style="margin-top:3rem">What you leave with</h2>
      <ul class="included">
        <li><Icon name="check" size={18} />A written plan, with the progression spelled out</li>
        <li><Icon name="check" size={18} />A home program you can do between sessions</li>
        <li><Icon name="check" size={18} />An explanation you can repeat to your family</li>
        <li><Icon name="check" size={18} />A referral, if a physician is what you actually need</li>
      </ul>
      <p style="margin-top:1.1rem">
        The plan is yours. Nothing here is contingent on booking a package afterward.
      </p>
    </div>
  </section>

  <section class="page-section alt" id="who-it-suits">
    <div class="page-section-narrow">
      <h2>Who it suits</h2>
      <div class="fit-grid">
        <div class="fit-card">
          <h3>A good fit if you are</h3>
          <ul>
            <li>Finished with formal PT but not back to normal</li>
            <li>Recovering from surgery or an injury</li>
            <li>Worried about balance, falls or losing independence</li>
            <li>Training around a history your last trainer did not understand</li>
            <li>Cleared by a physician and unsure what is safe</li>
          </ul>
        </div>
        <div class="fit-card">
          <h3>Not the right call if you</h3>
          <ul>
            <li>Have a new, undiagnosed or worsening injury — see a physician first</li>
            <li>Need emergency or urgent medical care</li>
            <li>Are looking for a diagnosis or a prescription</li>
            <li>Want a program emailed over without being assessed</li>
          </ul>
        </div>
      </div>
      <p style="margin-top:1.4rem; font-size:0.95rem">
        Bruce is a licensed DPT providing physical therapy-informed coaching through
        {" "}{practice.legalName}. That is not a substitute for medical diagnosis or
        treatment, and saying so plainly is part of the job.
      </p>
    </div>
  </section>

  <section class="page-section" id="fees">
    <div class="page-section-narrow">
      <h2>Fees</h2>
      <p>
        Straight answers before you call, because nobody should have to ask twice.
      </p>
      <dl class="fees">
        <div class="fees-row">
          <dt>Health Evaluation, 60 minutes</dt>
          <dd><span class="todo">CONFIRM RATE</span></dd>
        </div>
        <div class="fees-row">
          <dt>Ongoing sessions</dt>
          <dd><span class="todo">CONFIRM RATE</span></dd>
        </div>
        <div class="fees-row">
          <dt>Insurance</dt>
          <dd><span class="todo">CONFIRM: self-pay, or which plans</span></dd>
        </div>
        <div class="fees-row">
          <dt>Travel</dt>
          <dd>Included across {practice.regionLong}</dd>
        </div>
      </dl>
      <p class="form-note">
        These three values are the only unanswered things on the site. They are the first
        question most people have, so they are worth settling before launch.
      </p>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-band-inner">
      <h2>Book the evaluation.</h2>
      <p>Tell Bruce what is going on and he will come to you, or meet you on video.</p>
      <div class="cta-band-actions">
        <a class="cta-primary" href={withBase("/book")}>Book an evaluation</a>
        <a class="cta-secondary" href={practice.phoneHref}>Call {practice.phone}</a>
      </div>
    </div>
  </section>
</Site>
