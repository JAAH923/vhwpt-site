---
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";
import { practice } from "../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;
---

<Site
  title="Book an Evaluation | Dr. Bruce Valencia, DPT"
  description="Book a 60-minute health evaluation with Dr. Bruce Valencia, DPT. In-home across Broward and Palm Beach County, or live over video anywhere in the country."
  path="/book"
>
  <section class="book" aria-labelledby="book-title">
    <div class="book-form">
      <p class="label">Book</p>
      <h1 id="book-title">Book an evaluation</h1>
      <p class="lede">
        Tell Bruce what is going on and where you are. He answers his own messages,
        usually the same day.
      </p>

      <!--
        Placeholder until it is wired to Bruce's server (ENH-385). It must NOT
        ship as a mailto: — that is what the old site did and it silently failed
        on most phones. Until then, submitting shows the phone number instead.
      -->
      <form method="post" action="#" data-placeholder novalidate>
        <div class="field-row">
          <label class="field">
            <span>Your name</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Phone</span>
            <input name="phone" type="tel" autocomplete="tel" required />
          </label>
        </div>
        <label class="field">
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <div class="field-row">
          <label class="field">
            <span>Where would you like to meet?</span>
            <select name="where">
              <option>In my home</option>
              <option>Over video</option>
              <option>Not sure yet</option>
            </select>
          </label>
          <label class="field">
            <span>Your city</span>
            <input name="city" type="text" autocomplete="address-level2" />
          </label>
        </div>
        <label class="field">
          <span>What is going on?</span>
          <textarea
            name="about"
            placeholder="A recent surgery, an old injury, balance that is not what it was, or just wanting to get stronger safely."
          ></textarea>
        </label>
        <div class="form-foot">
          <button class="btn btn-primary" type="submit">Request an evaluation</button>
          <span class="todo">Form not connected yet</span>
        </div>
        <p class="form-status" role="status"></p>
      </form>
      <p class="form-note">
        Bruce reads these himself. If it is urgent, call
        {" "}<a href={practice.phoneHref}>{practice.phone}</a>. If it is a medical
        emergency, call 911.
      </p>
    </div>

    <div class="book-photo">
      <img
        src={withBase("/assets/photos/ai/room-open-table.webp")}
        alt="A portable treatment table set up in a bright living room"
      />
    </div>
  </section>

  <section class="section" aria-labelledby="call-title">
    <div class="wrap cols">
      <div>
        <h2 id="call-title">Or just call</h2>
        <dl class="facts">
          <div>
            <dt>Phone</dt>
            <dd><a href={practice.phoneHref}>{practice.phone}</a></dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd><span class="todo">Confirm hours</span></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${practice.email}`}>{practice.email}</a></dd>
          </div>
          <div>
            <dt>In-home visits</dt>
            <dd>{practice.regionLong}</dd>
          </div>
          <div>
            <dt>Virtual sessions</dt>
            <dd>Anywhere in the country</dd>
          </div>
        </dl>
      </div>
      <div>
        <h2>Fees &amp; insurance</h2>
        <dl class="facts">
          <div>
            <dt>Evaluation, 60 minutes</dt>
            <dd><span class="todo">Confirm rate</span></dd>
          </div>
          <div>
            <dt>Ongoing sessions</dt>
            <dd><span class="todo">Confirm rate</span></dd>
          </div>
          <div>
            <dt>Insurance</dt>
            <dd><span class="todo">Confirm</span></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="booking-title">
    <div class="wrap narrow">
      <h2 id="booking-title">What you are booking</h2>
      <p class="lead">
        A sixty-minute evaluation: history and goals, a movement and strength assessment,
        the findings explained in plain language, and a written plan you keep.
      </p>
      <a class="more" href={withBase("/services/health-evaluation")}>
        The evaluation in full <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>
</Site>

<script>
  import { practice } from "../data/site";

  // Nothing is sent until the form is wired to Bruce's server; say so plainly
  // and hand over the phone number instead of failing silently.
  const form = document.querySelector<HTMLFormElement>("form[data-placeholder]")!;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    form.querySelector(".form-status")!.textContent =
      `This form isn't connected yet, so nothing was sent. Please call ${practice.phone} or email ${practice.email}.`;
  });
</script>
