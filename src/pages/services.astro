---
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import Cta from "../components/Cta.astro";
import { practice, services, testimonials } from "../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;

const quoteFor = (anchor: string) =>
  testimonials.cards.find((t) => t.anchor === anchor);

// One photograph per view at most, so only four sections carry one. `ai`
// marks a generated image of a person, which shows the placeholder tag.
const photos: Record<string, { src: string; alt: string; ai: boolean }> = {
  rehab: {
    src: "/assets/photos/ai/knee-hands.webp",
    alt: "A clinician's hands supporting a client's knee on an exercise mat at home",
    ai: true,
  },
  senior: {
    src: "/assets/photos/ai/hallway-walk.webp",
    alt: "An older man walking steadily down a hallway at home",
    ai: true,
  },
  training: {
    src: "/assets/photos/ai/kettlebell-light.webp",
    alt: "A kettlebell and a foam roller on a wooden floor in window light",
    ai: false,
  },
  virtual: {
    src: "/assets/photos/ai/virtual-session.webp",
    alt: "A client working with a resistance band in front of a laptop video session",
    ai: true,
  },
};
---

<Site
  title="Services | Dr. Bruce Valencia, DPT | Broward & Palm Beach"
  description="Rehabilitation and recovery, senior fitness, personal training, weight management, youth conditioning, pre and postnatal fitness, virtual training and wellness programming, all led by a Doctor of Physical Therapy."
  path="/services"
>
  <PageHead
    label="Services"
    title="Eight ways to work together. One person running all of them."
    lede={`Whatever you come in for, it starts the same way: a full evaluation, then a written plan built for your body and your history. Sessions happen in your home across ${practice.regionLong}, or live over video from anywhere.`}
  />

  <!-- The first visit gets top billing: it is the entry point to everything below. -->
  <section class="section" id="start-here" aria-labelledby="start-title">
    <div class="wrap narrow">
      <p class="label">Start here</p>
      <h2 id="start-title">Everything starts with the evaluation.</h2>
      <p class="lead">
        Sixty minutes going through your history, watching how you actually move, and
        explaining what is going on. You leave with a written plan, and an honest answer
        if what you need is a physician rather than a trainer.
      </p>
      <a class="more" href={withBase("/services/health-evaluation")}>
        What happens in an evaluation <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <section class="section" aria-label="All services">
    <div class="wrap">
      <ul class="rows">
        {
          services.map((s) => (
            <li>
              <a href={`#${s.anchor}`}>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.lede}</p>
                </div>
                <Icon name="arrow" size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    services.map((s) => {
      const q = quoteFor(s.anchor);
      const photo = photos[s.anchor];
      return (
        <section class="section svc" id={s.anchor} aria-labelledby={`${s.anchor}-title`}>
          <div class="wrap">
            <div>
              <h2 id={`${s.anchor}-title`}>{s.title}</h2>
              <p class="lede">{s.lede}</p>
              <p>{s.body}</p>
              {q && (
                <blockquote class="quote">
                  <p>“{q.quote}”</p>
                  <footer>
                    <strong>{q.name}</strong>
                    {q.detail && <span class="label">{q.detail}</span>}
                  </footer>
                </blockquote>
              )}
            </div>
            <div>
              {photo && (
                <figure>
                  <img src={withBase(photo.src)} alt={photo.alt} loading="lazy" />
                  {photo.ai && <span class="tag label">AI photo</span>}
                </figure>
              )}
              <div class="covers">
                <span class="label">Commonly covers</span>
                <ul class="lines">
                  {s.covers.map((c) => <li>{c}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <Cta
    title="Not sure which one you need?"
    body="That is what the evaluation is for. Book it and Bruce will tell you, including if the answer is someone other than him."
  />
</Site>
