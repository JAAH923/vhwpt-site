---
/**
 * Short link to the latest Meadows class page. Change `to` when the next class page is made.
 * Keeps ?e= and other query strings.
 */
const to = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/events/meadows-dec-17/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>Class Sign-Up | Valencia Health &amp; Wellness</title>
    <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
  </head>
  <body><a href={to}>Continue to the class sign-up</a></body>
</html>
