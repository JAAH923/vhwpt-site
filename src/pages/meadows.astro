---
/**
 * The short address Bruce can share for "the next Meadows class". It forwards to that class's own
 * page under /events/, keeping any ?src= so sign-ups are still tagged by source. When a new class
 * page is added, change `latest` to it.
 */
const latest = "events/meadows-2026-12-17/";
const to = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${latest}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>Class Sign-Up | Valencia Health &amp; Wellness</title>
    <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
  </head>
  <body><a href={to}>Continue to the class sign-up</a></body>
</html>
