---
/**
 * Registration for Bruce's class and free fall-risk screening at The Meadows of Crystal Lake.
 * Bruce emails https://www.vhwpt.com/meadows to past class participants. Unlisted and out of
 * search, like the other sign-up pages. The form is components/EventSignupClass.astro.
 *
 * For the next class: change `next` and `event` below. The flyer's copy for the class goes in the
 * "About this class" block (leave it empty and it is not shown).
 */
import Kiosk from "../layouts/Kiosk.astro";
import EventSignupClass from "../components/EventSignupClass.astro";

const next = {
  title: "Holiday-Proof Habits",
  when: "Thursday, December 17",
  time: "11:00 AM",
  where: "Community Center, The Meadows of Crystal Lake",
};
const event = "meadows-2026-12-17";

// Bruce's Google review link, from his Google Business Profile ("Ask for reviews" / "Share review
// form"), like https://g.page/r/XXXX/review. Empty hides the "post it on Google" step.
const googleReview = "";

// The flyer's copy for this class: one string per paragraph. Empty means the block is hidden.
const about: string[] = [];
---

<Kiosk title="Class and Free Screening Sign-Up | Valencia Health & Wellness">
  <EventSignupClass next={next} event={event} googleReview={googleReview}>
    {
      about.length > 0 && (
        <section class="cabout" aria-label="About this class">
          {about.map((p) => <p>{p}</p>)}
        </section>
      )
    }
  </EventSignupClass>
</Kiosk>

<style>
  .cabout { margin-top: 20px; font-size: 19px; line-height: 1.5; }
  .cabout p + p { margin-top: 12px; }
</style>
