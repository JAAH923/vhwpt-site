---
/**
 * The old address of /signup/partners/. Sends anyone here (an iPad bookmark, a saved link) to the new
 * one, keeping ?e=<event> so their sign-ups are still tagged.
 */
const to = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/signup/partners/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>Sign Up | Valencia Health &amp; Wellness</title>
    <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
  </head>
  <body><a href={to}>Continue to the sign-up</a></body>
</html>
