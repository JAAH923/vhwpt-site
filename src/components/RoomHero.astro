---
/**
 * The home hero: a living room shot from one camera as two layers. The empty
 * room loops (curtains in the breeze from the open window); the treatment
 * table is a still cut-out laid over it, and it never moves against the room.
 * Both are generated placeholders until a real client's room is filmed. No
 * person is in frame, so they carry no AI tag (design/lock.md).
 */
import Pulse from "./Pulse.astro";
import { practice, actions } from "../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;

export interface Props {
  /** Play the curtain loop. Off on the live home page: the clip reads jerky
   *  rather than flowing (ENH-392), so the room shows as a still (its first
   *  frame). On for the "flowing" option in the hero comparison. */
  playLoop?: boolean;
}

const { playLoop = false } = Astro.props;
const still = withBase("/assets/photos/ai/room-open.webp");
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage" aria-hidden="true">
    {
      playLoop ? (
        <video class="room" autoplay muted loop playsinline preload="auto" poster={still}>
          <source src={withBase("/assets/video/room-open-loop.webm")} type="video/webm" />
          <source src={withBase("/assets/video/room-open-loop.mp4")} type="video/mp4" />
        </video>
      ) : (
        <img class="room" src={still} alt="" />
      )
    }
    <img class="room room-table" src={withBase("/assets/photos/ai/room-table-layer.webp")} alt="" />
  </div>

  <div class="hero-copy">
    <p class="label">Doctor of Physical Therapy&nbsp;· U.S. Navy Veteran</p>
    <h1 id="hero-title">Care that comes to you. From recovery to strength.</h1>
    <p class="hero-sub">
      Physical therapy and wellness in your home or care facility across
      {" "}{practice.regionLong}. Clinic and telehealth visits available case by case.
    </p>
    <!-- One decision: the form's first question splits PT from wellness. -->
    <div class="actions">
      <a class="btn btn-primary" href={withBase(actions.first.href)} data-book="">{actions.first.label}</a>
    </div>
  </div>

  <Pulse flatten />
</section>

<script>
  // Motion is opt-out: reduced-motion visitors get the still room. The loop
  // also pauses once the hero is off screen.
  const video = document.querySelector<HTMLVideoElement>(".hero video.room");
  if (video && matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.removeAttribute("autoplay");
    video.pause();
  } else if (video) {
    new IntersectionObserver(([e]) => (e.isIntersecting ? video.play().catch(() => {}) : video.pause())).observe(video);
  }
</script>
