---
/**
 * Question rows: one hairline accordion row per question, a plus that turns into
 * a minus, the answer underneath. Used on /questions (every topic) and on the
 * home page (the five in `homeQuestions`). While the answers are drafts, a row
 * whose answer has a fact for Bruce carries a "To confirm" pill.
 */
import Icon from "./Icon.astro";
import type { Question } from "../data/questions";

export interface Props {
  questions: Question[];
}
const { questions } = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;
---

<div class="qa-list">
  {
    questions.map((q) => (
      <details class="qa-item" id={q.id}>
        <summary>
          <h3>{q.q}</h3>
          {q.confirm && <span class="todo">To confirm</span>}
          <span class="qa-icon" aria-hidden="true" />
        </summary>
        <div class="qa-a">
          {q.a.map((p) => <p>{p}</p>)}
          {q.more && (
            <a class="more" href={withBase(q.more.href)}>
              {q.more.label} <Icon name="arrow" size={16} />
            </a>
          )}
          {q.confirm && (
            <p class="confirm">
              <span class="todo">Bruce to confirm</span> {q.confirm}
            </p>
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  .qa-list { border-top: 1px solid var(--hair); }
  .qa-item { border-bottom: 1px solid var(--hair); }
  .qa-item summary { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 16px; padding: 22px 0; cursor: pointer; list-style: none; }
  .qa-item summary::-webkit-details-marker { display: none; }
  .qa-item summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; border-radius: 4px; }
  .qa-item h3 { font-size: 19px; line-height: 1.35; font-weight: 600; text-wrap: pretty; }
  .qa-item summary:hover h3 { color: var(--grey); }

  /* The plus turns into a minus when the answer is open. */
  .qa-icon { position: relative; width: 20px; height: 20px; flex: none; grid-column: 3; }
  .qa-icon::before, .qa-icon::after { content: ""; position: absolute; left: 3px; right: 3px; top: 50%; height: 1.5px; margin-top: -0.75px; background: var(--ink); transition: transform 0.2s ease; }
  .qa-icon::after { transform: rotate(90deg); }
  .qa-item[open] .qa-icon::after { transform: rotate(0deg); }

  .qa-a { padding: 0 36px 28px 0; max-width: 64ch; }
  .qa-a p { font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .qa-a p + p { margin-top: 12px; }
  .qa-a .more { margin-top: 20px; }
  .qa-a .confirm { margin-top: 20px; font-size: 15px; line-height: 1.5; color: var(--grey); }
  .qa-a .confirm .todo { margin-right: 6px; color: var(--ink); }

  @media (max-width: 760px) {
    /* The pill drops under the question so the question keeps the width. */
    .qa-item summary { grid-template-columns: minmax(0, 1fr) auto; row-gap: 8px; }
    .qa-item summary .todo { grid-row: 2; justify-self: start; }
    .qa-icon { grid-column: 2; grid-row: 1; }
    .qa-a { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .qa-icon::before, .qa-icon::after { transition: none; }
  }
</style>
