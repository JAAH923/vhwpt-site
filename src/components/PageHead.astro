---
import Pulse from "./Pulse.astro";

export interface Props {
  label: string;
  title: string;
  lede: string;
  /** A small mono line under the lede, such as the credential row. */
  creds?: string;
  /** One contained photograph beside the copy. `ai` marks a generated image
   *  of a person, which carries the placeholder tag. */
  photo?: { src: string; alt: string; ai?: boolean; position?: string };
}

const { label, title, lede, creds, photo } = Astro.props;
---

<header class:list={["page-head", { "with-photo": photo }]}>
  <div class="wrap">
    <div>
      <p class="label">{label}</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      {creds && <p class="label creds">{creds}</p>}
    </div>
    {
      photo && (
        <figure>
          <img
            src={photo.src}
            alt={photo.alt}
            style={photo.position ? `object-position:${photo.position}` : undefined}
            loading="eager"
          />
          {photo.ai && <span class="tag">Illustrative image</span>}
        </figure>
      )
    }
  </div>
  <Pulse size="sm" at={0.18} />
</header>
