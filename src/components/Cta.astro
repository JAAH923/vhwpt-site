---
import Icon from "./Icon.astro";
import { actions } from "../data/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path = "") => `${basePath}${path.replace(/^\//, "")}`;

export interface Props {
  title: string;
  body: string;
  /** The quiet third action, a text link. Defaults to "Ask a question". */
  third?: { label: string; href: string };
}

const { title, body, third = actions.question } = Astro.props;
---

<section class="cta">
  <div class="wrap">
    <h2>{title}</h2>
    <p>{body}</p>
    <div class="actions">
      <a class="btn btn-primary" href={withBase(actions.pt.href)}>{actions.pt.label}</a>
      <a class="btn btn-line" href={withBase(actions.wellness.href)}>{actions.wellness.label}</a>
      <a class="more" href={withBase(third.href)}>{third.label} <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>
