# vhwpt.com on Bruce's Lightsail server: the Astro build in /srv/sites/vhwpt/current plus the
# booking form's PHP endpoint. Source: deploy/lightsail/sites/vhwpt.caddy in the vhwpt-site repo.

(vhwpt_site) {
	root * /srv/sites/vhwpt/current
	encode zstd gzip

	# The visit log: how people arrive (a QR code, a search, typing the address, another site) and
	# on which page. It keeps the time, the page, the site they came from and the browser name, and
	# nothing that identifies a person: no cookies, no scripts, no IP addresses, and only the host of
	# the referring site. Files, the API and the banner page are left out. 90 days are kept, then the
	# oldest are deleted. deploy/lightsail/traffic-report.py reads it.
	@untracked path /_astro/* /assets/* /banner/* /api/* /favicon.ico /apple-touch-icon.png /robots.txt /sitemap.xml /.well-known/*
	log_skip @untracked
	log {
		output file /var/log/caddy/vhwpt-visits.log {
			mode 640
			roll_size 20MiB
			roll_keep 20
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>Cf-Connecting-Ipv6 delete
				request>headers>True-Client-Ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
				request>headers>Referer regexp "^(https?://[^/?#]+).*$" "$1"
			}
		}
	}

	# The QR code on the event banner points at /qr, not at a page, so where it lands can change
	# after the banner is printed. 302 (temporary), never 301: browsers keep a 301 for good.
	# To send people somewhere else, change the one address below, then validate and reload Caddy.
	@qr path /qr /qr/
	redir @qr /?src=banner 302
	# /b is a short link to the banner page for Bruce and whoever prints it.
	@b path /b /b/
	redir @b /banner/ 302
	# More QR codes (the visit log tags each one, so the report counts them separately): add a pair of
	# lines like these, then print the QR for https://www.vhwpt.com/qr/<name>. Keep the src= tag
	# unique to that code. See deploy/lightsail/README.md ("Traffic").
	#   @qr_event path /qr/event /qr/event/
	#   redir @qr_event /event/?src=qr-event 302

	# The old WordPress URLs (same map as public/_redirects).
	@contact path /contact /contact/
	redir @contact /book 301
	@online path /services/online-training /services/online-training/
	redir @online /services/virtual-training 301
	@evals path /services/health-evaluations /services/health-evaluations/
	redir @evals /services/health-evaluation 301
	@category path /category/services /category/services/
	redir @category /services 301
	@old path /author/* /concepts/* /wp-admin /wp-admin/* /wp-login.php
	redir @old / 301
	@shop path /shop /shop/* /cart /cart/* /checkout /checkout/* /my-account /my-account/*
	respond @shop 410

	# Only the booking form and the event sign-up run PHP. Any other .php path, and files that are not for the
	# public, answer 404 rather than being sent as text.
	@form path /api/inquiry.php /api/event.php
	handle @form {
		php_fastcgi unix//run/php/php8.3-fpm.sock {
			env REMOTE_ADDR {client_ip}
		}
	}
	@hidden {
		path *.php /_redirects /.*
		not path /.well-known/*
	}
	respond @hidden 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server
}

# Preview by IP until vhwpt.com's DNS points here. Kept out of search.
http://3.226.58.165 {
	header X-Robots-Tag "noindex, nofollow"
	import vhwpt_site
}

# vhwpt.com is live here behind Cloudflare (SSL mode Full (strict)). The Origin Certificate for
# vhwpt.com and *.vhwpt.com is in /etc/caddy/certs; the private key never leaves this server.
# Installing this file on a new server needs those two files there first (see README.md).
www.vhwpt.com {
	tls /etc/caddy/certs/vhwpt.crt /etc/caddy/certs/vhwpt.key
	import vhwpt_site
}
vhwpt.com {
	tls /etc/caddy/certs/vhwpt.crt /etc/caddy/certs/vhwpt.key
	redir https://www.vhwpt.com{uri} 308
}
