# vhwpt.com on Bruce's Lightsail server: the Astro build in /srv/sites/vhwpt/current plus the
# booking form's PHP endpoint. Source: deploy/lightsail/sites/vhwpt.caddy in the vhwpt-site repo.

# The admin area itself, shared by www.vhwpt.com/admin and admin.vhwpt.com (both stay in service;
# see "Admin area" in README.md). One password for both: the hash is NOT in this repo, it lives on
# the server in /etc/caddy/private/vhwpt-admin-auth.caddy, one block like
#     basic_auth {
#         bruce <hash from `caddy hash-password`>
#     }
# If that file is missing, Caddy refuses the whole config, so the area can't be served open.
# The pages use root-relative addresses (/admin/signups, /assets/...), so they work unchanged
# whether the host is www.vhwpt.com or admin.vhwpt.com. No cookies or sessions are involved: the
# browser keeps the password per host.
(vhwpt_admin_area) {
	import /etc/caddy/private/vhwpt-admin-auth.caddy
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex, nofollow"
	@adminSignups path /admin/signups /admin/signups/ /admin/signups.csv
	handle @adminSignups {
		rewrite * /api/admin-signups.php
		php_fastcgi unix//run/php/php8.3-fpm.sock {
			env ADMIN_USER {http.auth.user.id}
		}
	}
	handle {
		file_server
	}
}

(vhwpt_site) {
	root * /srv/sites/vhwpt/current
	encode zstd gzip

	# The visit log: how people arrive (a QR code, a search, typing the address, another site) and
	# on which page. It keeps the time, the page, the site they came from and the browser name, and
	# nothing that identifies a person: no cookies, no scripts, no IP addresses, and only the host of
	# the referring site. Files, the API and the banner page are left out. 90 days are kept, then the
	# oldest are deleted. deploy/lightsail/traffic-report.py reads it.
	@untracked path /_astro/* /assets/* /banner/* /api/* /admin /admin/* /favicon.ico /apple-touch-icon.png /robots.txt /sitemap.xml /.well-known/*
	log_skip @untracked
	log {
		output file /var/log/caddy/vhwpt-visits.log {
			mode 640
			roll_size 20MiB
			roll_keep 20
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>Cf-Connecting-Ipv6 delete
				request>headers>True-Client-Ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
				request>headers>Referer regexp "^(https?://[^/?#]+).*$" "$1"
			}
		}
	}

	# The QR code on the event banner points at /qr, not at a page, so where it lands can change
	# after the banner is printed. 302 (temporary), never 301: browsers keep a 301 for good.
	# To send people somewhere else, change the one address below, then validate and reload Caddy.
	@qr path /qr /qr/
	redir @qr /?src=banner 302
	# /b is a short link to the banner page for Bruce and whoever prints it.
	@b path /b /b/
	redir @b /banner/ 302
	# The table sign's QR (design/table-sign/) opens the sign-up for residents and families. e= tags each
	# sign-up with the event: change it to the next event's name before the sign goes out again.
	@qr_signup path /qr/signup /qr/signup/
	redir @qr_signup /signup/clients/?e=meadows&src=qr-signup 302
	# More QR codes (the visit log tags each one, so the report counts them separately): add a pair of
	# lines like these, then print the QR for https://www.vhwpt.com/qr/<name>. Keep the src= tag
	# unique to that code. See deploy/lightsail/README.md ("Traffic").
	#   @qr_event path /qr/event /qr/event/
	#   redir @qr_event /event/?src=qr-event 302

	# The old WordPress URLs (same map as public/_redirects).
	@contact path /contact /contact/
	redir @contact /book 301
	@online path /services/online-training /services/online-training/
	redir @online /services/virtual-training 301
	@evals path /services/health-evaluations /services/health-evaluations/
	redir @evals /services/health-evaluation 301
	@category path /category/services /category/services/
	redir @category /services 301
	@old path /author/* /concepts/* /wp-admin /wp-admin/* /wp-login.php
	redir @old / 301
	@shop path /shop /shop/* /cart /cart/* /checkout /checkout/* /my-account /my-account/*
	respond @shop 410

	# Bruce's admin area (vhwpt.com/admin): his sign-ups list and other private pages, behind one
	# password (see the vhwpt_admin_area snippet above). Only over HTTPS on www.vhwpt.com; the plain-http
	# test address answers 404. This path stays in service alongside admin.vhwpt.com; it does not redirect.
	@admin {
		path /admin /admin/*
		host www.vhwpt.com
	}
	handle @admin {
		import vhwpt_admin_area
	}
	@adminElsewhere {
		path /admin /admin/*
		not host www.vhwpt.com
	}
	respond @adminElsewhere 404

	# Only the booking form and the event sign-up run PHP. Any other .php path, and files that are not for the
	# public, answer 404 rather than being sent as text.
	@form path /api/inquiry.php /api/event.php
	handle @form {
		php_fastcgi unix//run/php/php8.3-fpm.sock {
			env REMOTE_ADDR {client_ip}
		}
	}
	@hidden {
		path *.php /_redirects /.*
		not path /.well-known/*
	}
	respond @hidden 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server
}

# Preview by IP until vhwpt.com's DNS points here. Kept out of search.
http://3.226.58.165 {
	header X-Robots-Tag "noindex, nofollow"
	import vhwpt_site
}

# vhwpt.com is live here behind Cloudflare (SSL mode Full (strict)). The Origin Certificate for
# vhwpt.com and *.vhwpt.com is in /etc/caddy/certs; the private key never leaves this server.
# Installing this file on a new server needs those two files there first (see README.md).
www.vhwpt.com {
	tls /etc/caddy/certs/vhwpt.crt /etc/caddy/certs/vhwpt.key
	import vhwpt_site
}
vhwpt.com {
	tls /etc/caddy/certs/vhwpt.crt /etc/caddy/certs/vhwpt.key
	redir https://www.vhwpt.com{uri} 308
}

# admin.vhwpt.com: the same admin area on its own address. Needs an A record for admin in Cloudflare
# (proxied, orange cloud) pointing at 3.226.58.165. The certificate is the same Origin Certificate as
# above (it covers *.vhwpt.com), so Caddy does no ACME and nothing here depends on DNS being live; the
# block just receives no traffic until the record exists. Cloudflare's own certificate faces visitors.
# Same URL space as www/admin on purpose (/admin/, /admin/signups, /admin/signups.csv).
admin.vhwpt.com {
	tls /etc/caddy/certs/vhwpt.crt /etc/caddy/certs/vhwpt.key
	root * /srv/sites/vhwpt/current
	encode zstd gzip

	# Separate from the visit log (which keeps no IP addresses): fail2ban reads this one to find
	# repeated wrong passwords. It keeps the visitor's IP, the page and the result. The password
	# itself is never written (Caddy replaces the Authorization header with REDACTED). One week kept.
	log {
		output file /var/log/caddy/vhwpt-admin.log {
			mode 640
			roll_size 5MiB
			roll_keep 4
			roll_keep_for 168h
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	# Addresses fail2ban has banned after repeated wrong passwords. Defines @banned. The file is written
	# by /usr/local/sbin/vhwpt-admin-ban; with nobody banned it holds one harmless documentation address.
	import /etc/caddy/private/vhwpt-admin-banned.caddy
	handle @banned {
		header Retry-After 3600
		respond "Too many wrong passwords from this address. Try again in an hour." 429
	}

	@adminPaths path /admin /admin/*
	handle @adminPaths {
		import vhwpt_admin_area
	}

	# What the admin pages load (fonts, styles, the logo): public files, the same ones www serves.
	@shared path /_astro/* /assets/* /favicon.ico /apple-touch-icon.png
	handle @shared {
		file_server
	}

	@home path /
	handle @home {
		redir * /admin/ 302
	}

	# Everything else (the banner and event pages the admin menu links to, and any stray address)
	# lives on www: send it there. Never the PHP files or the private folder.
	handle {
		redir * https://www.vhwpt.com{uri} 302
	}
}
