# play.vhwpt.com on Bruce's Lightsail server: games and tools for his events (the prize wheel
# first). Plain HTML from the play/ folder of the vhwpt-site repo, published to
# /srv/sites/play/current by deploy-play.sh. Source: deploy/lightsail/sites/play.caddy.
#
# Behind Cloudflare (proxied), using the same Origin Certificate as vhwpt.com, which covers
# *.vhwpt.com. Cloudflare needs one DNS record: A  play  3.226.58.165  (proxied).
play.vhwpt.com {
	tls /etc/caddy/certs/vhwpt.crt /etc/caddy/certs/vhwpt.key
	root * /srv/sites/play/current
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Pages are checked on every load, so an iPad left on the wheel picks up changes.
	@pages path / *.html */
	header @pages Cache-Control "no-cache"

	file_server
}
